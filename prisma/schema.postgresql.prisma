// CloudVault Prisma Schema - Production PostgreSQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  passwordHash      String
  name              String
  role              String         @default("USER")
  storageQuotaBytes Float          @default(10737418240) // 10 GB default
  storageUsedBytes  Float          @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  folders           Folder[]
  files             File[]
  fileVersions      FileVersion[]
  auditLogs         AuditLog[]

  @@map("users")
}

model Folder {
  id        String    @id @default(cuid())
  name      String
  userId    String
  parentId  String?
  isTrash   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Folder?   @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]  @relation("FolderHierarchy")
  files     File[]

  @@index([userId])
  @@index([parentId])
  @@index([userId, isTrash])
  @@map("folders")
}

model File {
  id                   String        @id @default(cuid())
  name                 String
  originalName         String
  mimeType             String
  sizeBytes            Float
  userId               String
  folderId             String?
  isStarred            Boolean       @default(false)
  isTrash              Boolean       @default(false)
  currentVersionNumber Int           @default(1)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder               Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  versions             FileVersion[]
  shareLinks           ShareLink[]

  @@index([userId])
  @@index([folderId])
  @@index([userId, isTrash])
  @@index([userId, isStarred])
  @@map("files")
}

model FileVersion {
  id             String   @id @default(cuid())
  fileId         String
  versionNumber  Int
  storageKey     String
  sizeBytes      Float
  mimeType       String
  checksumSha256 String?
  uploadedById   String
  createdAt      DateTime @default(now())

  file           File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploadedBy     User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@unique([fileId, versionNumber])
  @@index([fileId])
  @@index([storageKey])
  @@map("file_versions")
}

model ShareLink {
  id            String    @id @default(cuid())
  fileId        String
  tokenHash     String    @unique
  permission    String    @default("VIEW")
  expiresAt     DateTime?
  maxDownloads  Int?
  downloadCount Int       @default(0)
  isRevoked     Boolean   @default(false)
  createdAt     DateTime  @default(now())

  file          File      @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([tokenHash])
  @@map("share_links")
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  details      String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
