# CloudVault Environment Configuration

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://cloudvault:cloudvault_secret_password@localhost:5432/cloudvault?schema=public"

# Authentication Security
# Generate with: openssl rand -base64 32
AUTH_SECRET="cloudvault_super_secret_session_key_32bytes_minimum_length_example"
SESSION_MAX_AGE_SECONDS=604800

# Object Storage Configuration (S3 / MinIO)
# Set STORAGE_DRIVER to "s3" for MinIO or AWS S3, or "local" for standalone local filesystem without Docker
STORAGE_DRIVER="local"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET_NAME="cloudvault-storage"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadminpassword"
S3_FORCE_PATH_STYLE="true"

# Quota & Limits (Bytes)
DEFAULT_USER_QUOTA_BYTES=10737418240 # 10 GB
MAX_FILE_SIZE_BYTES=104857600       # 100 MB per file
